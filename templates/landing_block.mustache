{{!
    @template theme_lexa/landing_block

    Block in the landing region (main content: no landmark role, no skip link).

    Example context (json):
    {
        "id": "block0",
        "class": "block block_html",
        "type": "html",
        "title": "Test block",
        "blockinstanceid": 1,
        "content": "<p>Hello block world!</p>"
    }

}}
{{! Start Block Container }}
<{{#title}}section{{/title}}{{^title}}div{{/title}} id="{{id}}"
     class="{{#hidden}}hidden{{/hidden}} {{class}} {{#hascontrols}}block_with_controls{{/hascontrols}} card{{#additionalcss}} {{additionalcss}}{{/additionalcss}}"
     data-block="{{type}}"
     data-instance-id="{{blockinstanceid}}"
     {{#title}}aria-labelledby="instance-{{blockinstanceid}}-header"{{/title}}>

    {{! Block contents }}
    <div class="card-body">

        {{! Block header }}
        {{#title}}
            <h3 id="instance-{{blockinstanceid}}-header" class="h5 card-title d-inline">{{{title}}}</h3>
        {{/title}}

        {{#hascontrols}}
            <div class="block-controls float-right header">
                {{{controls}}}
            </div>
        {{/hascontrols}}

        <div class="card-text content">
            {{{content}}}
            <div class="footer">{{{footer}}}</div>
            {{{annotation}}}
        </div>

    </div>

{{! End Block Container }}
</{{#title}}section{{/title}}{{^title}}div{{/title}}>
